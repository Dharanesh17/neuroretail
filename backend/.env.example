# NeuroRetail Enterprise AI Environment Configuration

# Application settings
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Security & CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Admin initial credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
DHARANESH_PASSWORD=your_secure_password_here

# Token Session Expiration (in hours)
TOKEN_TTL_HOURS=24

# File Upload Limit (in megabytes)
MAX_CONTENT_MB=10

